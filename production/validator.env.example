# Validator settings for FactoryHorde as mechanism 1 of mainnet subnet 12. Fill in the empty values and
# pass this file to installer/install.sh --env-file (see production/README.md). The installer adds its defaults and
# generated Pylon tokens and writes the installation's .env without comments.

# Mainnet subnet 12, where ComputeHorde is mechanism 0 and FactoryHorde mechanism 1.
ENVIRONMENT=production
BITTENSOR_NETWORK=finney
BITTENSOR_ARCHIVE_NETWORK=archive
NETUID=12
MECHANISM_ID=1
SUBNET_TEMPO=360
BLOCK_DURATION_SECONDS=12

# The validator hotkey shared with ComputeHorde's validator, below HOST_WALLET_DIR (an absolute path such
# as /home/ubuntu/.bittensor/wallets) and mounted read-only into Pylon. Only the hotkey and coldkeypub.txt
# belong on the server. VALIDATOR_HOTKEY is the hotkey's SS58 address.
BITTENSOR_WALLET_NAME=
BITTENSOR_WALLET_HOTKEY_NAME=
HOST_WALLET_DIR=
VALIDATOR_HOTKEY=

# The validator image is pinned in the configuration release; the review judge is selected here.
# The 60-minute round uses 30/5/25-minute windows.
VALIDATOR_DISPATCH_ENABLED=true
VALIDATOR_WEIGHTS_ENABLED=true
JUDGE_MODE=review
# Optional judging model (a Claude Code alias or full model ID), frozen into each new round. Empty uses the judge's default.
JUDGE_MODEL=
JUDGE_IMAGE=
GENERATION_SECONDS=1800
CONFIRMATION_SECONDS=300
EVALUATION_SECONDS=1500
JUDGE_STOP_RESERVE_SECONDS=300
STOP_GRACE_SECONDS=60

# Operator-owned directory of task JSON files, each run by every miner in new rounds. Atomic replacement
# affects only new admissions; an empty directory blocks admission.
TASK_DIRECTORY=/home/ubuntu/factory-horde/tasks

# Real factories: each factory container joins the internal inference network, where it reaches only
# the inference proxy on a separate isolated network, with more memory, processes and /tmp space.
EXECUTOR_FACTORY_NETWORK=factory-horde-inference
# Judges may install declared PyPI/npm dependencies through the registry proxy (inference profile).
EXECUTOR_REGISTRY_NETWORK=factory-horde-registry
EXECUTOR_MEMORY=2g
EXECUTOR_PIDS_LIMIT=512
EXECUTOR_TMP_SIZE=1g
# Run every factory (and later every judge) of a round at once: miners x tasks.
EXECUTOR_MAX_RUNNING_JOBS=6

# Claude subscription token from "claude setup-token", used by the inference proxy for all factories.
# It is kept only on the validator server and never given to factories.
CLAUDE_CODE_OAUTH_TOKEN=

# Push metrics to the company monitoring stack (read in its central Grafana). The login is created on the
# monitoring server with add_loki_target.sh and needs an entry in its otel_inventory.yml.
# The inference profile starts the inference proxy.
COMPOSE_PROFILES=alloy,inference
METRICS_UPSTREAM_URL=https://alloy.reef.pl
METRICS_UPSTREAM_USER=
METRICS_UPSTREAM_PASSWORD=

# Let plain "docker compose" commands in the installation directory address the application.
COMPOSE_PROJECT_NAME=factory-horde
COMPOSE_FILE=envs/deployed/docker-compose.yml

# Miner settings for FactoryHorde as mechanism 1 of mainnet subnet 12. Copy to miner/.env, fill in the
# empty values and start miner/docker-compose.yml (see production/README.md).

# Mainnet subnet 12, where ComputeHorde is mechanism 0 and FactoryHorde mechanism 1.
ENVIRONMENT=production
BITTENSOR_NETWORK=finney
BITTENSOR_ARCHIVE_NETWORK=archive
NETUID=12
BLOCK_DURATION_SECONDS=12

# This hotkey's commitment is shared with ComputeHorde, whose manifest changes can be written every 5 minutes.
# 200 bytes keeps both writers within the hotkey's 3,100-byte commitment quota per tempo.
COMMITMENT_MAX_BYTES=200

# Miner wallet below HOST_WALLET_DIR (an absolute path such as /home/ubuntu/.bittensor/wallets),
# mounted read-only into Pylon.
BITTENSOR_WALLET_NAME=
BITTENSOR_WALLET_HOTKEY_NAME=default
HOST_WALLET_DIR=

# Pylon on loopback and its three distinct tokens (for example: openssl rand -hex 24).
PYLON_HOST_PORT=8000
MINER_PYLON_TOKEN=
PYLON_OPEN_ACCESS_TOKEN=
PYLON_METRICS_TOKEN=

# The factory image this miner commits: a public GHCR reference pinned by digest.
FACTORY_IMAGE=

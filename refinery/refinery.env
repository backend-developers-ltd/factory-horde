# Shared, non-secret settings for the Refinery deployment. Sourced by the refinery/ scripts.
# Rerun the relevant setup.sh after changing a value.

# Refinery development chain (private VLAN) and FactoryHorde's subnet on it.
BITTENSOR_NETWORK=ws://10.0.0.10:9944
CHAIN_RPC_URL=http://10.0.0.10:9944
CHAIN_GENESIS=0xe185ddf8629910ec509d81f6568ccb227e6f2721747f7468d64261f8425ec0a9
NETUID=11
MECHANISM_ID=0
SUBNET_TEMPO=360
BLOCK_DURATION_SECONDS=12
ENVIRONMENT=refinery

# Application release installed on the validator by installer/install.sh (full commit SHA on GitHub).
RELEASE_REF=e09a281036645f9b07b5e95a67fdf0ef3c499027

# Published images (envs/candidate/release.json). The validator image is the common Compose default.
JUDGE_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-judge@sha256:e46ef2808251ee3bd7df35e321b9e8383d82373f335da890920ad93724c289cf
SUBMITTER_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-submitter-prototype@sha256:260ae682875e7dc93797838f42b255bb62a9ad46169fab3eefaccef59090cf29
FACTORY_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-factory@sha256:8e38b2081f7628ca9dab545fb00ee756e23c1ed5d4d292db0e41c1012acbc8a3

# Wallets under /root/.bittensor/wallets on each server (hotkey "default").
VALIDATOR_WALLET=factory-horde-validator
MINER_WALLET=miner1

# Development funding from //Alice: top up to FUND_TAO when the free balance drops below MIN_BALANCE_TAO.
MIN_BALANCE_TAO=10
FUND_TAO=100
# Initial validator stake, added only when the validator hotkey has none.
VALIDATOR_STAKE_TAO=1

# Validator round windows (seconds): 10/5/15 minutes, a 30-minute round.
GENERATION_SECONDS=600
CONFIRMATION_SECONDS=300
EVALUATION_SECONDS=900
JUDGE_STOP_RESERVE_SECONDS=300
STOP_GRACE_SECONDS=60

# How often the miner resubmits FACTORY_IMAGE (systemd time span).
SUBMIT_INTERVAL=1h

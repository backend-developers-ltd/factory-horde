# Miner settings for the Refinery development chain. Copy to miner/.env, fill in the empty values
# and start miner/docker-compose.yml (see refinery/README.md).

# Refinery development chain (private VLAN) and FactoryHorde's subnet on it.
ENVIRONMENT=refinery
BITTENSOR_NETWORK=ws://10.0.0.10:9944
NETUID=11
BLOCK_DURATION_SECONDS=12

# Registry owner whose packages hold FactoryHorde submissions; commitments carry only package and digest.
SUBMISSION_NAMESPACE=ghcr.io/backend-developers-ltd

# Miner wallet below HOST_WALLET_DIR (an absolute path such as /home/ubuntu/.bittensor/wallets),
# mounted read-only into Pylon.
BITTENSOR_WALLET_NAME=miner1
BITTENSOR_WALLET_HOTKEY_NAME=default
HOST_WALLET_DIR=

# Pylon on loopback and its three distinct tokens (for example: openssl rand -hex 24).
PYLON_HOST_PORT=8000
MINER_PYLON_TOKEN=
PYLON_OPEN_ACCESS_TOKEN=
PYLON_METRICS_TOKEN=

# The factory image this miner commits: a public GHCR reference pinned by digest.
FACTORY_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-factory@sha256:8e38b2081f7628ca9dab545fb00ee756e23c1ed5d4d292db0e41c1012acbc8a3

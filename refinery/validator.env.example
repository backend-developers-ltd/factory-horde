# Validator settings for the Refinery development chain. Fill in the empty values and pass this file
# to installer/install.sh --env-file (see refinery/README.md). The installer adds its defaults and
# generated Pylon tokens and writes the installation's .env without comments.

# Refinery development chain (private VLAN) and FactoryHorde's subnet on it.
ENVIRONMENT=refinery
BITTENSOR_NETWORK=ws://10.0.0.10:9944
NETUID=11
MECHANISM_ID=0
SUBNET_TEMPO=360
BLOCK_DURATION_SECONDS=12

# Validator wallet below HOST_WALLET_DIR (an absolute path such as /home/ubuntu/.bittensor/wallets),
# mounted read-only into Pylon. VALIDATOR_HOTKEY is the hotkey's SS58 address.
BITTENSOR_WALLET_NAME=factory-horde-validator
BITTENSOR_WALLET_HOTKEY_NAME=default
HOST_WALLET_DIR=
VALIDATOR_HOTKEY=

# Rounds: published judge image and windows in seconds (30/5/25 minutes, a 60-minute round).
VALIDATOR_DISPATCH_ENABLED=true
VALIDATOR_WEIGHTS_ENABLED=true
JUDGE_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-judge@sha256:e46ef2808251ee3bd7df35e321b9e8383d82373f335da890920ad93724c289cf
GENERATION_SECONDS=1800
CONFIRMATION_SECONDS=300
EVALUATION_SECONDS=1500
JUDGE_STOP_RESERVE_SECONDS=300
STOP_GRACE_SECONDS=60

# Task given to every factory in new rounds. Keep it on one line, in single quotes.
TASK_SPECIFICATION='Write a command-line to-do list manager in Python. Put the complete program in a single file named main.py that uses only the standard library, stores tasks in a JSON file, and supports the subcommands add, list, done and remove. Also write README.md describing installation and usage.'

# Real factories: each factory container joins the internal inference network, where it reaches only
# the inference proxy (and other running factories), with more memory, processes and /tmp space.
EXECUTOR_FACTORY_NETWORK=factory-horde-inference
EXECUTOR_MEMORY=2g
EXECUTOR_PIDS_LIMIT=512
EXECUTOR_TMP_SIZE=1g

# Claude subscription token from "claude setup-token", used by the inference proxy for all factories.
# It is kept only on the validator server and never given to factories.
CLAUDE_CODE_OAUTH_TOKEN=

# Push metrics to the company monitoring stack (read in its central Grafana). The login is created on the
# monitoring server with add_loki_target.sh and needs an entry in its otel_inventory.yml.
# The inference profile starts the inference proxy.
COMPOSE_PROFILES=alloy,inference
METRICS_UPSTREAM_URL=https://alloy.reef.pl
METRICS_UPSTREAM_USER=
METRICS_UPSTREAM_PASSWORD=

# Let plain "docker compose" commands in the installation directory address the application.
COMPOSE_PROJECT_NAME=factory-horde
COMPOSE_FILE=envs/deployed/docker-compose.yml

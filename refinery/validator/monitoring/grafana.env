# Template for /etc/factory-horde/grafana.env, the Grafana and Caddy settings on the validator.
# refinery/validator/setup-monitoring.sh installs it and fills in both values; do not commit them here.

# Grafana "admin" password. Generated once when empty and applied on every setup run.
GRAFANA_ADMIN_PASSWORD=
# Public address served by Caddy: GRAFANA_ADDRESS from refinery.env, else the default route's source address.
GRAFANA_ADDRESS=

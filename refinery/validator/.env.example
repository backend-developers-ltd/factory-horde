# Settings of the Refinery validator. refinery/validator/setup.sh copies this file to .env in the
# checkout root on first run and fills in the empty values. That .env is the server's only settings
# file: the installer adds its own defaults and generated Pylon tokens to it and rewrites it without
# comments. After editing .env, run installer/update_compose.sh "$PWD" (or wait for the updater).

# Refinery development chain (private VLAN) and FactoryHorde's subnet on it.
ENVIRONMENT=refinery
BITTENSOR_NETWORK=ws://10.0.0.10:9944
NETUID=11
MECHANISM_ID=0
SUBNET_TEMPO=360
BLOCK_DURATION_SECONDS=12

# Validator wallet below HOST_WALLET_DIR (filled in: ~/.bittensor/wallets), mounted read-only into
# Pylon. VALIDATOR_HOTKEY is the hotkey's SS58 address, filled in once the wallet exists.
BITTENSOR_WALLET_NAME=factory-horde-validator
BITTENSOR_WALLET_HOTKEY_NAME=default
HOST_WALLET_DIR=
VALIDATOR_HOTKEY=

# Rounds: published judge image and windows in seconds (10/5/15 minutes, a 30-minute round).
VALIDATOR_DISPATCH_ENABLED=true
VALIDATOR_WEIGHTS_ENABLED=true
JUDGE_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-judge@sha256:e46ef2808251ee3bd7df35e321b9e8383d82373f335da890920ad93724c289cf
GENERATION_SECONDS=600
CONFIRMATION_SECONDS=300
EVALUATION_SECONDS=900
JUDGE_STOP_RESERVE_SECONDS=300
STOP_GRACE_SECONDS=60

# Grafana behind Caddy at https://GRAFANA_ADDRESS/ (filled in: the server's public IP address);
# log in as "admin" with GRAFANA_ADMIN_PASSWORD (generated).
COMPOSE_PROFILES=grafana
GRAFANA_ADDRESS=
GRAFANA_ADMIN_PASSWORD=

# Let plain "docker compose" commands in the checkout root address the installed application.
COMPOSE_PROJECT_NAME=factory-horde
COMPOSE_FILE=envs/deployed/docker-compose.yml

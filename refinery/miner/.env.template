# Settings of the miner server, its only configuration file. refinery/miner/setup.sh copies this
# template to refinery/miner/.env and fills the values marked "generated". Rerun
# refinery/miner/setup.sh after every change. Use literal KEY=value lines without quotes or spaces.

# Chain and subnet: the Refinery development chain (private VLAN) and FactoryHorde's subnet on it.
ENVIRONMENT=refinery
BITTENSOR_NETWORK=ws://10.0.0.10:9944
NETUID=11
BLOCK_DURATION_SECONDS=12

# Miner identity. Pylon reads HOST_WALLET_DIR/<wallet>/hotkeys/<hotkey>; the coldkey is not needed there.
BITTENSOR_WALLET_NAME=miner1
BITTENSOR_WALLET_HOTKEY_NAME=default
# Generated: refinery/miner/wallets in this checkout.
HOST_WALLET_DIR=

# Pylon on loopback and its access tokens. Generated.
PYLON_HOST_PORT=8000
MINER_PYLON_TOKEN=
PYLON_OPEN_ACCESS_TOKEN=
PYLON_METRICS_TOKEN=

# Factory image committed on chain: a public GHCR reference pinned by digest.
FACTORY_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-factory@sha256:8e38b2081f7628ca9dab545fb00ee756e23c1ed5d4d292db0e41c1012acbc8a3
# Published one-shot submitter and how often it resubmits FACTORY_IMAGE (systemd time span).
SUBMITTER_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-submitter-prototype@sha256:260ae682875e7dc93797838f42b255bb62a9ad46169fab3eefaccef59090cf29
SUBMIT_INTERVAL=1h

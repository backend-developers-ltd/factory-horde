# Settings of the Refinery miner. refinery/miner/setup.sh copies this file to .env beside it on
# first run and fills in the empty values. That .env is the server's only settings file; rerun
# refinery/miner/setup.sh after editing it.

# Refinery development chain (private VLAN) and FactoryHorde's subnet on it.
ENVIRONMENT=refinery
BITTENSOR_NETWORK=ws://10.0.0.10:9944
NETUID=11
BLOCK_DURATION_SECONDS=12

# Miner wallet below HOST_WALLET_DIR (filled in: ~/.bittensor/wallets), mounted read-only into Pylon.
BITTENSOR_WALLET_NAME=miner1
BITTENSOR_WALLET_HOTKEY_NAME=default
HOST_WALLET_DIR=

# Pylon on loopback and its tokens (generated).
PYLON_HOST_PORT=8000
MINER_PYLON_TOKEN=
PYLON_OPEN_ACCESS_TOKEN=
PYLON_METRICS_TOKEN=

# The factory image the miner commits, the published one-shot submitter, and how often the timer
# resubmits (systemd time span).
FACTORY_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-factory@sha256:8e38b2081f7628ca9dab545fb00ee756e23c1ed5d4d292db0e41c1012acbc8a3
SUBMITTER_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-submitter-prototype@sha256:260ae682875e7dc93797838f42b255bb62a9ad46169fab3eefaccef59090cf29
SUBMIT_INTERVAL=1h

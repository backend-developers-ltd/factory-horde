# Settings of the production validator deployment, the only configuration file on the server.
# setup-prod.sh copies this template to envs/production/.env (linked as ./.env) and fills the
# values marked "generated". Set the values marked "required", then run ./deploy.sh; rerun it
# after every change. Use literal KEY=value lines without quotes or spaces.

# Chain and subnet: the Refinery development chain (private VLAN) and FactoryHorde's subnet on it.
ENVIRONMENT=refinery
BITTENSOR_NETWORK=ws://10.0.0.10:9944
NETUID=11
MECHANISM_ID=0
SUBNET_TEMPO=360
BLOCK_DURATION_SECONDS=12

# Validator identity. Pylon reads HOST_WALLET_DIR/<wallet>/hotkeys/<hotkey>; the coldkey is not needed there.
BITTENSOR_WALLET_NAME=factory-horde-validator
BITTENSOR_WALLET_HOTKEY_NAME=default
# Generated: <checkout>/wallets.
HOST_WALLET_DIR=
# Required: SS58 address of the validator hotkey (printed by refinery/wallet.sh validator).
VALIDATOR_HOTKEY=

# Pylon access tokens. Generated.
VALIDATOR_PYLON_IDENTITY_TOKEN=
VALIDATOR_PYLON_OPEN_ACCESS_TOKEN=
PYLON_METRICS_TOKEN=

# Execution. The validator container, the host executor and every factory and judge container run
# as this non-root UID/GID, which owns the data root. Generated: the factoryhorde service account
# and <checkout>/data.
CONTAINER_UID=
CONTAINER_GID=
FACTORY_HORDE_DATA_ROOT=
# Host executor concurrency and per-container limits.
EXECUTOR_WORKERS=32
EXECUTOR_POLL_SECONDS=2
EXECUTOR_MEMORY=512m
EXECUTOR_CPUS=1
EXECUTOR_PIDS_LIMIT=128

# Rounds: 10 minutes generation, 5 minutes stop confirmation and 15 minutes evaluation.
VALIDATOR_DISPATCH_ENABLED=true
JUDGE_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-judge@sha256:e46ef2808251ee3bd7df35e321b9e8383d82373f335da890920ad93724c289cf
GENERATION_SECONDS=600
CONFIRMATION_SECONDS=300
EVALUATION_SECONDS=900
JUDGE_STOP_RESERVE_SECONDS=300
STOP_GRACE_SECONDS=60

# Weight writes through Pylon.
VALIDATOR_WEIGHTS_ENABLED=true

# Grafana behind Caddy on ports 80 and 443.
# Required: public IP address or host name of this server; Caddy obtains its certificate for it.
GRAFANA_ADDRESS=
# Password of the Grafana "admin" user. Generated; deploy.sh applies it on every run.
GRAFANA_ADMIN_PASSWORD=

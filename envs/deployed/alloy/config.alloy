// Pushes the validator host's metrics to the company monitoring stack.
//
// Alloy scrapes the same targets as the local Prometheus and sends them as OTLP to
// METRICS_UPSTREAM_URL (the OTLP gateway in front of Mimir). The gateway authenticates the login
// and stamps client_server_group, environment, host and the other identity labels from its own
// inventory, so nothing here sets them. Each job name becomes service.name, so series arrive as
// job="factory-horde/<job>" with the target address as instance.

prometheus.scrape "node_exporter" {
	targets    = [{__address__ = "host.docker.internal:" + sys.env("NODE_EXPORTER_PORT")}]
	job_name   = "node-exporter"
	forward_to = [otelcol.receiver.prometheus.default.receiver]
}

prometheus.scrape "pylon" {
	targets    = [{__address__ = "pylon:8000"}]
	job_name   = "pylon"
	forward_to = [otelcol.receiver.prometheus.default.receiver]

	authorization {
		type        = "Bearer"
		credentials = sys.env("PYLON_METRICS_TOKEN")
	}
}

prometheus.scrape "validator" {
	targets    = [{__address__ = "validator:9101"}]
	job_name   = "validator"
	forward_to = [otelcol.receiver.prometheus.default.receiver]
}

// Claude subscription budget read from the inference proxy's responses.
prometheus.scrape "claude_usage" {
	targets    = [{__address__ = "claude-usage-exporter:9102"}]
	job_name   = "claude-usage"
	forward_to = [otelcol.receiver.prometheus.default.receiver]
}

// The converter carries no HELP or TYPE, so every family arrives as a gauge. Values, rate() and
// histogram_quantile() are unaffected.
otelcol.receiver.prometheus "default" {
	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		metrics = [otelcol.exporter.otlphttp.metrics_upstream.input]
	}
}

otelcol.auth.basic "metrics_upstream" {
	username = sys.env("METRICS_UPSTREAM_USER")
	password = sys.env("METRICS_UPSTREAM_PASSWORD")
}

otelcol.exporter.otlphttp "metrics_upstream" {
	client {
		endpoint = sys.env("METRICS_UPSTREAM_URL")
		auth     = otelcol.auth.basic.metrics_upstream.handler
	}
}

# Installer generates isolated paths, matching UID/GID and independent local tokens.
ENVIRONMENT=localnet
NETUID=2
MECHANISM_ID=1
SUBNET_TEMPO=360
BITTENSOR_NETWORK=ws://subtensor:9944
BITTENSOR_WALLET_NAME=validator
BITTENSOR_WALLET_HOTKEY_NAME=default
BLOCK_DURATION_SECONDS=0.25
SUBTENSOR_HOST_PORT=19944
PYLON_HOST_PORT=18000
PROMETHEUS_HOST_PORT=19090
VALIDATOR_DATA_ROOT=/var/lib/factory-horde
EXECUTOR_PLATFORM=linux/amd64
EXECUTOR_PYTHON=/usr/bin/python3.14
EXECUTOR_POLL_SECONDS=2
EXECUTOR_WORKERS=32
EXECUTOR_MEMORY=512m
EXECUTOR_CPUS=1
EXECUTOR_PIDS_LIMIT=128
# Coordinator admission is opt-in; check_rounds supplies bounded test settings itself.
VALIDATOR_DISPATCH_ENABLED=false
VALIDATOR_HOTKEY=
JUDGE_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-judge@sha256:e46ef2808251ee3bd7df35e321b9e8383d82373f335da890920ad93724c289cf
GENERATION_SECONDS=3600
CONFIRMATION_SECONDS=300
EVALUATION_SECONDS=3300
JUDGE_STOP_RESERVE_SECONDS=300
STOP_GRACE_SECONDS=60
VALIDATOR_WEIGHTS_ENABLED=false
WEIGHT_TEMPERATURE=0.1
WEIGHT_EPOCH_OFFSET=0
VALIDATOR_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-validator-prototype@sha256:71807ba7181bf544388d2b809d69777adefc5cda89124e2d918c4b5834112eb5
SUBMITTER_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-submitter-prototype@sha256:260ae682875e7dc93797838f42b255bb62a9ad46169fab3eefaccef59090cf29
FACTORY_IMAGE=ghcr.io/backend-developers-ltd/factory-horde-factory@sha256:8e38b2081f7628ca9dab545fb00ee756e23c1ed5d4d292db0e41c1012acbc8a3
